/* ---- design tokens ---- */
/* A股约定：红涨绿跌 */
$up: #e5484d;
$down: #2f9e6e;
$flat: #8a8f98;
$warning: #f5a524;
$danger: #e5484d;

/* light theme (P4): uncomment to enable
$up: #dc2626;
$down: #16a34a;
*/

/* colorblind theme: red→red, green→blue
$up: #e5484d;
$down: #3b82f6;
*/

TopBar {
    dock: top;
    height: 1;
    background: $surface;
    color: $text;
    padding: 0 1;
}

Footer {
    dock: bottom;
}

#chat-log {
    padding: 0 1;
}

ChatInput {
    dock: bottom;
    height: 3;
    border: round $primary-darken-2;
    margin: 0 1;
    padding: 0 1;
}

ChatInput:focus {
    border: round $accent;
}

/* HintBar：输入框上方的上下文提示 */
HintBar {
    height: auto;
    max-height: 6;
    padding: 0 2;
    color: $text-muted;
}

/* ToolIndicator：dexter 风格工具调用指示 */
ToolIndicator {
    height: auto;
    padding: 0 1;
    margin: 0 0 0 0;
}

ToolIndicator .ti-header {
    height: 1;
}

ToolIndicator .ti-detail {
    height: 1;
    padding-left: 2;
    color: $text-muted;
}

/* WorkingIndicator：思考中 spinner / 重试态 */
WorkingIndicator {
    height: 1;
    padding: 0 1;
}

.turn-stats {
    height: 1;
    padding: 0 1;
}

.interrupted-line {
    height: 1;
    padding: 0 1;
}

.memory-receipt {
    height: 1;
    padding: 0 1;
}

.hint-card {
    border: round $warning;
    color: $text-muted;
    padding: 1 2;
    margin: 1 0;
}

.workflow-card {
    border-left: thick $accent;
    padding: 0 0 0 1;
    margin: 0 0 1 0;
}

/* 对话消息 */
.user-msg {
    padding: 0 1;
    margin: 0 0 0 4;
    color: $text;
}

.assistant-msg {
    padding: 0 1;
    margin: 0 4 0 0;
}

/* 富卡片（slash 命令 + 工具结果渲染共用） */
.card {
    border: round $primary-darken-2;
    padding: 0 2;
    margin: 0 0 1 0;
    height: auto;
}

/* 启动欢迎卡 */
.welcome-card {
    border: round $accent;
    padding: 1 2;
    margin: 1 0;
    height: auto;
}
